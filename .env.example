DJANGO_ENV=production
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=replace-with-at-least-50-random-characters
DJANGO_ALLOWED_HOSTS=motor.example.com
PUBLIC_BASE_URL=https://motor.example.com
POSTGRES_DB=motor
POSTGRES_USER=motor
POSTGRES_PASSWORD=replace-with-strong-password
POSTGRES_HOST=db
REDIS_URL=redis://redis:6379/1
CLIENT_TOKEN_ENCRYPTION_KEYS=replace-with-separate-random-value
EMAIL_ENABLED=0
SECURE_SSL_REDIRECT=1
DEMO_ADMIN_PASSWORD=replace-before-public-deploy
